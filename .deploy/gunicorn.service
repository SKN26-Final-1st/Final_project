[Unit]
Description=myapp Django gunicorn daemon
After=network.target

[Service]
User=ec2-user
Group=nginx

WorkingDirectory=/var/www/app/backend
EnvironmentFile=/etc/secrets.env
Environment="PATH=/var/www/app/backend/.venv/bin"

ExecStart=/var/www/app/backend/.venv/bin/gunicorn \
          --workers 3 \
          --timeout 120 \
          --bind 127.0.0.1:8000 \
          --access-logfile - \
          --error-logfile - \
          config.wsgi:application

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
